{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: Ensure Build Directory",
      "type": "shell",
      "command": "mkdir",
      "args": [
        "-p",
        "${workspaceFolder}/.vscode/build/${relativeFileDirname}"
      ],
      "problemMatcher": []
    },
    {
      "label": "C++: Build Active File",
      "type": "cppbuild",
      "command": "/usr/bin/clang++",
      "args": [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-g",
        "${file}",
        "-o",
        "${workspaceFolder}/.vscode/build/${relativeFileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "dependsOn": "C++: Ensure Build Directory",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Builds the currently active C++ file."
    }
  ]
}
